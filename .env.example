# =================================================================
# Twilio WhatsApp
# =================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# "sandbox" for dev (free, requires join code), "live" for paid WhatsApp Business Sender
TWILIO_ENV=sandbox

# Always +14155238886 for the public Twilio WhatsApp Sandbox
TWILIO_WHATSAPP_NUMBER_SANDBOX=whatsapp:+14155238886

# Your paid WhatsApp Business sender — only used when TWILIO_ENV=live
TWILIO_WHATSAPP_NUMBER_LIVE=whatsapp:+1234567890

# Legacy fallback — if neither *_SANDBOX nor *_LIVE is set, this is used.
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Content SID for the Quick Reply confirmation template
# Create via: `npm run create-template` after auth keys are set
TWILIO_CONFIRMATION_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public https origin of this server (no trailing slash). Signs/validates Twilio callbacks:
# POST /webhook (as <origin>/webhook) and POST /twilio/status. Unset = webhook signature check OFF (dev only).
# PUBLIC_BASE_URL=https://your-host.example.com

# Exact URL Twilio posts inbound messages to, if it isn't PUBLIC_BASE_URL + /webhook (overrides it for the signature check).
# TWILIO_WEBHOOK_URL=https://your-host.example.com/webhook

# Approved WhatsApp template for the morning digest: {{1}} date, {{2}} body. Unset = free-form, only inside the 24h window.
# TWILIO_DIGEST_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Approved invoice template: {{1}} customer, {{2}} amount, {{3}} due date, {{4}} PDF URL. Unset = free-form text + PDF.
# TWILIO_INVOICE_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# That template's approved body with {{n}} placeholders (\n allowed); shown in the send preview.
# TWILIO_INVOICE_TEMPLATE_TEXT=Hi {{1}}, your invoice for {{2}} is due {{3}}: {{4}}

# Approved payment-reminder template: {{1}} customer, {{2}} total, {{3}} statement (no link variable).
# TWILIO_REMINDER_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# That template's approved body with {{n}} placeholders; shown in the reminder preview.
# TWILIO_REMINDER_TEMPLATE_TEXT=Hi {{1}}, a reminder that {{2}} is outstanding: {{3}}

# =================================================================
# OpenAI (extraction + chitchat)
# =================================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voice-note transcription model (falls back to whisper-1 if this one isn't enabled on the project)
MEDIA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Max size of an inbound photo/PDF/voice note in bytes (default 20 MB). Must be a positive integer or the server won't boot.
MEDIA_MAX_BYTES=20971520

# =================================================================
# Postgres (Railway or any managed PG)
# =================================================================
# Use the public proxy URL for local dev, internal URL when bot is deployed alongside DB
DATABASE_URL=postgresql://user:password@host:port/database

# =================================================================
# ERPNext (accounting backend)
# =================================================================
# Base URL of your ERPNext instance, no trailing slash
ERPNEXT_URL=https://your-erpnext.example.com

# Per-user API credentials. For single-tenant dev, set these as the default user;
# for multi-tenant prod, store per-user in the users table instead.
# scripts/provision-user.js uses these as the ADMIN credentials and (pilot mode) copies them onto the
# provisioned user's row — they can reach every Company on the instance. See README → Onboarding.
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# Default Company (an ERPNext multi-Company tenant) used by the seeded test user
ERPNEXT_COMPANY_DEFAULT=Your Company Name

# Print Format used for invoice PDFs sent to customers (unset = ERPNext's default for Sales Invoice)
# ERPNEXT_INVOICE_PRINT_FORMAT=Tax Invoice

# Trust layer: amounts at or above this (reporting currency) can be flagged "Unusually large" /
# "New payee, first payment" on the confirmation card. Default 20000.
# TRUST_LARGE_AMOUNT_FLOOR=20000

# =================================================================
# Onboarding (unknown WhatsApp numbers → in-chat signup, src/onboarding/)
# =================================================================
# "closed" = invite code required, "open" = anyone can sign up. Unset: closed when NODE_ENV=production, open otherwise.
# ONBOARDING_MODE=closed
# Comma-separated invite codes for closed mode (matched case-insensitively). Used as onboarding_source "invite:<code>".
# ONBOARDING_INVITE_CODES=PILOT-2026,GEMS

# =================================================================
# Server
# =================================================================
PORT=3000

# "production" turns on the strict boot checks in src/config.js (https PUBLIC_BASE_URL or
# TWILIO_WEBHOOK_URL, TWILIO_CONFIRMATION_CONTENT_SID set, LOG_MESSAGES off, SEED_TEST_USER_PHONE
# unset) and refuses unsigned webhooks. The Docker image defaults to production. `npm run check:env` runs the checks.
# NODE_ENV=development

# Skip the daily job scheduler (digest, reminders, cleanup) on this instance: 1/true/yes/on.
DISABLE_JOBS=false

# =================================================================
# Dev convenience
# =================================================================
# Phone number (E.164) seeded as a test user on startup. Leave blank for prod.
SEED_TEST_USER_PHONE=+12025550100

# Persist every incoming/outgoing message to the messages table for debugging.
# Set to "true" only in dev. Production retention policy is no chat logs.
LOG_MESSAGES=true
