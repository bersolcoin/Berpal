# =================================================================
# Twilio WhatsApp
# =================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# "sandbox" for dev (free, requires join code), "live" for paid WhatsApp Business Sender
TWILIO_ENV=sandbox

# Always +14155238886 for the public Twilio WhatsApp Sandbox
TWILIO_WHATSAPP_NUMBER_SANDBOX=whatsapp:+14155238886

# Your paid WhatsApp Business sender — only used when TWILIO_ENV=live
TWILIO_WHATSAPP_NUMBER_LIVE=whatsapp:+1234567890

# Legacy fallback — if neither *_SANDBOX nor *_LIVE is set, this is used.
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Content SID for the Quick Reply confirmation template
# Create via: `npm run create-template` after auth keys are set
TWILIO_CONFIRMATION_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =================================================================
# OpenAI (extraction + chitchat)
# =================================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =================================================================
# Postgres (Railway or any managed PG)
# =================================================================
# Use the public proxy URL for local dev, internal URL when bot is deployed alongside DB
DATABASE_URL=postgresql://user:password@host:port/database

# =================================================================
# ERPNext (accounting backend)
# =================================================================
# Base URL of your ERPNext instance, no trailing slash
ERPNEXT_URL=https://your-erpnext.example.com

# Per-user API credentials. For single-tenant dev, set these as the default user;
# for multi-tenant prod, store per-user in the users table instead.
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# Default Company (an ERPNext multi-Company tenant) used by the seeded test user
ERPNEXT_COMPANY_DEFAULT=Your Company Name

# =================================================================
# Server
# =================================================================
PORT=3000

# =================================================================
# Dev convenience
# =================================================================
# Phone number (E.164) seeded as a test user on startup. Leave blank for prod.
SEED_TEST_USER_PHONE=+12025550100

# Persist every incoming/outgoing message to the messages table for debugging.
# Set to "true" only in dev. Production retention policy is no chat logs.
LOG_MESSAGES=true
